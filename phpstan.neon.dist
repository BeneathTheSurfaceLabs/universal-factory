includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # HasUniversalFactory is public API applied by consuming applications,
        # so it is never used within the analysed paths.
        -
            identifier: trait.unused
            path: src/Traits/HasUniversalFactory.php
